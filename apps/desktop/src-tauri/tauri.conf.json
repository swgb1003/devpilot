{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevPilot",
  "version": "0.1.0",
  "identifier": "com.devpilot.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "beforeBuildCommand": "corepack pnpm --filter @devpilot/contracts build && corepack pnpm --filter @devpilot/agent build && corepack pnpm build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevPilot",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
