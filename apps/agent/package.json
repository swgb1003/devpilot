{
  "name": "@devpilot/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm --filter @devpilot/contracts build && tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@devpilot/contracts": "workspace:*",
    "selfsigned": "5.5.0"
  }
}
